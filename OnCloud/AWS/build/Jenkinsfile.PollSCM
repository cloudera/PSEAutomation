pipeline {
    agent any

    environment {
        GIT_REPO_URL = 'https://github.com/cloudera-labs/cdp-tf-quickstarts.git'
        REMOTE_JOB_AWS = 'hol-automation'  // Replace with your AWS deploy job name
        REMOTE_JOB_AZURE = 'hol-automation-azure'  // Replace with your Azure deploy job name
        EMAIL_RECIPIENTS = 'pse-apac@cloudera.com,aktiwari@cloudera.com,ksahu@cloudera.com'  // Email recipient(s)
        HOL_AUTO_EXEC_DIR = "/home/holautosa/HOL_AUTO_EXEC_DIR"
        REPO_DIR = "${HOL_AUTO_EXEC_DIR}/cdp-tf-quickstarts"
    }

    parameters {
        string(name: 'BUILD_BRANCH', defaultValue: 'main', description: 'Git branch for AWS local image build (IMAGE_BUILD_BRANCH on deploy jobs)')
        string(name: 'AZURE_BUILD_BRANCH', defaultValue: 'azure-automation', description: 'Git branch for Azure local image build (IMAGE_BUILD_BRANCH on deploy jobs)')
        string(name: 'BUILD_IMAGE_TAG', defaultValue: 'testbuildimage', description: 'Local Docker image tag passed to deploy/destroy when BUILD_LOCAL_IMAGE=true')
    }
    
    triggers {
        pollSCM('30 21 * * 3')  // Adjust polling schedule as needed
    }
    
    stages {
        stage('Checkout') {
            steps {
                // Checkout the repository
                dir(REPO_DIR) {
                    git url: "${GIT_REPO_URL}", branch: 'main'
                }
            }
        }
        stage('Build Test Images') {
            steps {
                script {
                    echo 'Skipping registry image build — deploy/destroy jobs build locally (BUILD_LOCAL_IMAGE=true).'
                    // Registry image build (re-enable to push to Docker Hub before deploy):
                    /*
                    parallel(
                        'AWS': {
                            echo 'Triggering hol-automation-build-aws job...'
                            build job: 'hol-automation-build-aws',
                                parameters: [
                                    string(name: 'BUILD_BRANCH', value: "${params.BUILD_BRANCH}")
                                ],
                                propagate: true
                        },
                        'Azure': {
                            echo 'Triggering hol-automation-build-azure job...'
                            build job: 'hol-automation-build-azure',
                                parameters: [
                                    string(name: 'BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}")
                                ],
                                propagate: true
                        }
                    )
                    */
                }
            }
        }
        stage('Test Deploy') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    def awsWorkshopName = "caws${env.BUILD_NUMBER}"
                    def azureWorkshopName = "cazs${env.BUILD_NUMBER}"

                    // Define common parameters for AWS deploy
                    def awsDeployParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'AWS_REGION', value: 'ap-southeast-1'),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: awsWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: awsWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CDW,CAI,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'g4dn.xlarge'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'ACTION', value: 'provision'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: 'testmain'),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: true),
                        string(name: 'BUILD_IMAGE_TAG', value: "${params.BUILD_IMAGE_TAG}"),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'v0.15.0')
                    ]

                    // Define common parameters for Azure deploy
                    def azureDeployParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'AZURE_REGION', value: 'eastus'),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: azureWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: azureWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CDW,CAI,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'Standard_D8s_v3'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'Standard_D8s_v3'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'Standard_NC4as_T4_v3'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'ACTION', value: 'provision'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: 'testmain'),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: true),
                        string(name: 'BUILD_IMAGE_TAG', value: "${params.BUILD_IMAGE_TAG}"),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    parallel(
                        'AWS': {
                            echo 'Triggering AWS deploy job...'
                            build job: REMOTE_JOB_AWS, parameters: awsDeployParams
                        },
                        'Azure': {
                            echo 'Triggering Azure deploy job...'
                            build job: REMOTE_JOB_AZURE, parameters: azureDeployParams
                        }
                    )
                }
            }
            post {
                success {
                    script {
                        currentBuild.result = 'SUCCESS'
                    }
                }
                failure {
                    script {
                        currentBuild.result = 'FAILURE'
                        // Send failure notification for deploy
                        emailext (
                            to: EMAIL_RECIPIENTS,
                            subject: "❌  Pipeline Status: Deploy Stage Failed",
                            body: """
                            <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #ffdddd; background-color: #f8d7da; color: #721c24;">
                                <h2 style="color: #c82333;">❌ The Deploy Stage Has Failed</h2>
                                <p>Please check the logs for more details.</p>
                                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                                    <tr>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job Name</th>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job URL</th>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;">${JOB_NAME}</td>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;"><a href="${env.BUILD_URL}" style="text-decoration: none; color: #337ab7;">${env.BUILD_URL}</a></td>
                                    </tr>
                                </table>
                            </div>
                            """,
                            mimeType: 'text/html',
                            from: 'psejenkins@cloudera.com'
                        )
                        error('Deployment failed, aborting pipeline.')
                    }
                }
            }
        }

        stage('Test Destroy') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    def awsWorkshopName = "caws${env.BUILD_NUMBER}"
                    def azureWorkshopName = "cazs${env.BUILD_NUMBER}"

                    // Define common parameters for AWS destroy
                    def awsDestroyParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'AWS_REGION', value: 'ap-southeast-1'),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: awsWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: awsWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CAI,CDW,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'g4dn.xlarge'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'ACTION', value: 'destroy'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: 'testmain'),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: true),
                        string(name: 'BUILD_IMAGE_TAG', value: "${params.BUILD_IMAGE_TAG}"),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'v0.15.0')
                    ]

                    // Define common parameters for Azure destroy
                    def azureDestroyParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'AZURE_REGION', value: 'eastus'),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: azureWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: azureWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CAI,CDW,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'Standard_D8s_v3'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'Standard_D8s_v3'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'Standard_NC4as_T4_v3'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'ACTION', value: 'destroy'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: 'testmain'),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: true),
                        string(name: 'BUILD_IMAGE_TAG', value: "${params.BUILD_IMAGE_TAG}"),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    parallel(
                        'AWS': {
                            echo 'Triggering AWS destroy job...'
                            build job: REMOTE_JOB_AWS, parameters: awsDestroyParams
                        },
                        'Azure': {
                            echo 'Triggering Azure destroy job...'
                            build job: REMOTE_JOB_AZURE, parameters: azureDestroyParams
                        }
                    )
                }
            }
            post {
                success {
                    script {
                        currentBuild.result = 'SUCCESS'
                    }
                }
                failure {
                    script {
                        currentBuild.result = 'FAILURE'
                        // Send email notification when deploy succeeded but destroy failed
                        emailext (
                            to: EMAIL_RECIPIENTS,
                            subject: "❌ Pipeline Status: Deploy Success, Destroy Failed",
                            body: """
                            <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #ffdddd; background-color: #f8d7da; color: #721c24;">
                                <h2 style="color: #c82333;">❌ Pipeline Status Update</h2>
                                <p style="color: #c82333;">Deploy Stage: <strong>SUCCESS</strong></p>
                                <p style="color: #c82333;">Destroy Stage: <strong>FAILED</strong></p>
                                <p>Please check the logs for more details.</p>
                                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                                    <tr>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job Name</th>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job URL</th>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;">${JOB_NAME}</td>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;"><a href="${env.BUILD_URL}" style="text-decoration: none; color: #337ab7;">${env.BUILD_URL}</a></td>
                                    </tr>
                                </table>
                            </div>
                            """,
                            mimeType: 'text/html',
                            from: 'psejenkins@cloudera.com'
                        )
                    }
                }
            }
        }
    }

    post {
        success {
            // Send email when both deploy and destroy succeed
            emailext (
                to: EMAIL_RECIPIENTS,
                subject: "✅ Pipeline Status: Deploy and Destroy Success",
                body: """
                <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #d4edda; background-color: #d4edda; color: #155724;">
                    <h2 style="color: #155724;">✅ Pipeline Completed Successfully!</h2>
                    <p>Both Deploy and Destroy stages have succeeded.</p>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                        <tr>
                            <th style="background-color: #c3e6cb; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job Name</th>
                            <th style="background-color: #c3e6cb; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job URL</th>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #e0e0e0;">${JOB_NAME}</td>
                            <td style="padding: 10px; border: 1px solid #e0e0e0;"><a href="${env.BUILD_URL}" style="text-decoration: none; color: #337ab7;">${env.BUILD_URL}</a></td>
                        </tr>
                    </table>
                </div>
                """,
                mimeType: 'text/html',
                from: 'psejenkins@cloudera.com'
            )
        }
        failure {
            script {
                echo "Pipeline has failed"
            }
        }
        always {
            script {
                echo "Pipeline completed with status: ${currentBuild.result}"
            }
        }
    }
}
