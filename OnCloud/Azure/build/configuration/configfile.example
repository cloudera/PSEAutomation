# Copy this file to your userconfig directory as "configfile" (no extension).
# Format: KEY:value  — no quotes, no blank line after the last entry.
# Lines starting with # are ignored when copying; remove comments for production use.

# --- Core workshop settings (required) ---
PROVISION_KEYCLOAK:yes
KEYCLOAK_ADMIN_PASSWORD:changeme
PROVISION_CAII:no
# AZURE_REGION: CDP infra + datalake region. Must support PostgreSQL Flexible Server for your subscription
# (check: az postgres flexible-server list-skus --location <region>). Default westus2; eastus may return empty SKUs.
AZURE_REGION:westus2
CDP_DEPLOYMENT_TYPE:public
WORKSHOP_NAME:pseworkshop
NUMBER_OF_WORKSHOP_USERS:10
WORKSHOP_USER_PREFIX:pseworkshop
WORKSHOP_USER_DEFAULT_PASSWORD:changeme
LOCAL_MACHINE_IP:203.0.113.10/32
ENABLE_DATA_SERVICES:CDW,CAI,CDE,CDF
DELETE_DATAHUBS:true
DOMAIN:example.com
HOSTEDZONEID:Z1234567890ABC
# DATALAKE_VERSION: CDP datalake runtime (e.g. 7.3.2 or latest). Independent of AZURE_REGION; pick a version
# supported by your CDP entitlement. ARM error "Version should be in: []" usually means region/subscription SKU gap, not a bad version string.
DATALAKE_VERSION:7.3.2

# --- Optional: existing SSH key (omit to auto-generate) ---
# Place <SSH_KEY_NAME>.pem in the same userconfig directory.
# SSH_KEY_NAME is also accepted as AWS_KEY_PAIR for parity with AWS configfiles.
#SSH_KEY_NAME:my-keypair

# --- Optional: CDP quota overrides ---
#CDP_SAML_PROVIDER_LIMIT:10
#CDP_USER_LIMIT:1000
#CDP_GROUP_LIMIT:50

# --- Optional: data service sizing overrides ---
# CDW activation requires one of these supported compute VM types. Default: Standard_E16ads_v5.
#CDW_VRTL_WAREHOUSE_SIZE:small
#CDW_DATAVIZ_SIZE:small
# CDE (cdp de enable-service): sizing applies to CORE or ALLP per CDE_VC_TIER; inactive tier is 0/0/0 in enable-cde.yml.
#CDE_INSTANCE_TYPE:Standard_D8s_v5
#CDE_INITIAL_INSTANCES:1
#CDE_MIN_INSTANCES:0
#CDE_MAX_INSTANCES:25
#CDE_SPARK_VERSION:AUTO
#CDE_VC_TIER:CORE
# When CAI or PROVISION_CAII is enabled, CDP Terraform also provisions a premium
# Azure Files NFS share (secure transfer disabled) with private endpoints in the CDP VNet.
# Each CAI workbench uses a dedicated subdirectory ({WORKSHOP_NAME}-cai-ws) with chown 8536:8536.
# Re-run provision is idempotent: NFS share unchanged; mkdir/chown skipped if already correct.
# The per-workbench mount path is passed to CAI as --existing-nfs (NFS v4.1).
#CAI_NFS_VERSION:4.1
#CAI_WS_INSTANCE_TYPE:Standard_D8s_v5
#CAI_MIN_INSTANCES:1
#CAI_MAX_INSTANCES:5
#CAI_ENABLE_GPU:no
# CDF (cdp df enable-service): --min-k8s-node-count / --max-k8s-node-count, --use-public-load-balancer. Cluster/LB subnets come from CDP Terraform outputs (not configfile). CDF_INSTANCE_TYPE is optional; leave it unset so CDP chooses the default node type. Setting it requires the actor to have permission to set custom DataFlow instance types. Requires env-scoped DFAdmin on the CDP caller (assignCdpEnvAdminRoles.sh after Terraform).
#CDF_INSTANCE_TYPE:Standard_D8s_v5
#CDF_MIN_NODES:3
#CDF_MAX_NODES:3
#CDF_USE_PUBLIC_LB:yes

# --- CDP env admin roles (provisioner only; not workshop users) ---
# After Terraform, assignCdpEnvAdminRoles.sh grants env admin roles to the active ~/.cdp API
# caller (human via cdp iam get-user, or machine user via access-key match). Jenkins also sets
# BUILD_USER_ID; optional standalone: docker run -e BUILD_USER_ID=you@cloudera.com ...

# --- Optional: resource tags (pse-owner is required for cost tracking) ---
ENV_TAGS:{pse-owner=you@cloudera.com,apn-id=12345}

# After a successful provision, workshop access details are written to:
#   /userconfig/{WORKSHOP_NAME}.txt
# Jenkins attaches this file to the success email when run from CI.

# --- Optional: Azure service principal (use instead of mounting ~/.azure) ---
#AZURE_CLIENT_ID:00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_SECRET:your-secret
#AZURE_TENANT_ID:00000000-0000-0000-0000-000000000000
#AZURE_SUBSCRIPTION_ID:00000000-0000-0000-0000-000000000000

# --- Optional: AWS credentials for Keycloak Route53 DNS (use instead of mounting ~/.aws) ---
#AWS_ACCESS_KEY_ID:AKIA...
#AWS_SECRET_ACCESS_KEY:your-secret
#AWS_SESSION_TOKEN:optional-for-temporary-creds
#AWS_REGION:us-east-1
