pipeline {
    agent any

    environment {
        GIT_REPO_URL = 'https://github.com/cloudera-labs/cdp-tf-quickstarts.git'
        REMOTE_JOB_AWS = 'hol-automation-deploy-aws'
        REMOTE_JOB_AZURE = 'hol-automation-deploy-azure'
        BUILD_JOB_AWS = 'hol-automation-build-aws'
        BUILD_JOB_AZURE = 'hol-automation-build-azure'
        EMAIL_RECIPIENTS = 'pse-apac@cloudera.com,aktiwari@cloudera.com,ksahu@cloudera.com'  // Email recipient(s)
        HOL_AUTO_EXEC_DIR = "/home/holautosa/HOL_AUTO_EXEC_DIR"
        REPO_DIR = "${HOL_AUTO_EXEC_DIR}/cdp-tf-quickstarts"
    }

    parameters {
        booleanParam(name: 'REFRESH_JENKINSFILE', defaultValue: false, description: 'Reload changes from Jenkinsfile and exit.')
        choice(
            name: 'CLOUD_TARGET',
            choices: ['BOTH', 'AWS', 'AZURE'],
            description: 'Run integration deploy/destroy on AWS, Azure, or both in parallel'
        )
        string(name: 'AWS_BUILD_BRANCH', defaultValue: 'main', description: 'Git branch for the AWS candidate image')
        string(name: 'AZURE_BUILD_BRANCH', defaultValue: 'main', description: 'Git branch for the Azure candidate image')
        string(name: 'AWS_REGION', defaultValue: 'ap-southeast-1', description: 'AWS region for provision and destroy')
        string(name: 'AZURE_REGION', defaultValue: 'westus2', description: 'Azure region with PostgreSQL Flexible Server capacity for this subscription')
        string(name: 'DOMAIN', defaultValue: 'clouderapartners.click', description: 'Route53 domain for Keycloak/DNS (passed to deploy/destroy jobs)')
        string(name: 'HOSTEDZONEID', defaultValue: '', description: 'Route53 hosted zone ID for DOMAIN (set on Jenkins job; not stored in repo)')
        string(name: 'DATALAKE_VERSION', defaultValue: '7.3.2', description: 'CDP datalake runtime passed to deploy/destroy (e.g. 7.3.2)')
        booleanParam(name: 'DELETE_DATAHUBS', defaultValue: true, description: 'Delete environment Data Hubs during destroy.')
    }
    
    triggers {
        pollSCM('30 21 * * 3')  // Adjust polling schedule as needed
    }
    
    stages {
        stage('DRY RUN: Reload Jenkinsfile') {
            when { expression { return params.REFRESH_JENKINSFILE ==~ /(?i)(Y|YES|T|TRUE|ON|RUN)/ } }
            steps {
                script {
                    currentBuild.result = 'ABORTED'
                    error('DRY RUN COMPLETED. JOB PARAMETERIZED.')
                }
            }
        }
        stage('Checkout') {
            steps {
                // Checkout the repository
                dir(REPO_DIR) {
                    git url: "${GIT_REPO_URL}", branch: 'main'
                }
            }
        }
        stage('Build Test Images') {
            steps {
                script {
                    def runAws = params.CLOUD_TARGET in ['BOTH', 'AWS']
                    def runAzure = params.CLOUD_TARGET in ['BOTH', 'AZURE']
                    if (!runAws && !runAzure) {
                        error("CLOUD_TARGET '${params.CLOUD_TARGET}' did not select any cloud")
                    }
                    echo "CLOUD_TARGET=${params.CLOUD_TARGET} (AWS=${runAws}, Azure=${runAzure})"
                    env.CANDIDATE_TAG = "candidate-${java.util.UUID.randomUUID()}"
                    def buildBranches = [:]
                    if (runAws) {
                        buildBranches['AWS'] = {
                            echo "Triggering ${BUILD_JOB_AWS}..."
                            def result = build job: BUILD_JOB_AWS,
                                parameters: [
                                    string(name: 'BUILD_BRANCH', value: "${params.AWS_BUILD_BRANCH}"),
                                    string(name: 'PRIMARY_TAG', value: env.CANDIDATE_TAG),
                                    string(name: 'PROMOTE_SOURCE_TAG', value: ''),
                                    string(name: 'TF_QS_VER', value: 'main'),
                                    booleanParam(name: 'PUSH_SECONDARY_TAG', value: false),
                                    booleanParam(name: 'MULTI_PLATFORM_BUILD', value: false),
                                    booleanParam(name: 'REFRESH_JENKINSFILE', value: false)
                                ],
                                propagate: false
                            env.AWS_BUILD_OK = (result.result == 'SUCCESS').toString()
                            echo "AWS candidate build: ${result.result}"
                        }
                    }
                    if (runAzure) {
                        buildBranches['Azure'] = {
                            echo "Triggering ${BUILD_JOB_AZURE}..."
                            def result = build job: BUILD_JOB_AZURE,
                                parameters: [
                                    string(name: 'BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}"),
                                    string(name: 'PRIMARY_TAG', value: env.CANDIDATE_TAG),
                                    string(name: 'PROMOTE_SOURCE_TAG', value: ''),
                                    string(name: 'TF_QS_VER', value: 'main'),
                                    booleanParam(name: 'PUSH_SECONDARY_TAG', value: false),
                                    booleanParam(name: 'MULTI_PLATFORM_BUILD', value: false),
                                    booleanParam(name: 'REFRESH_JENKINSFILE', value: false)
                                ],
                                propagate: false
                            env.AZURE_BUILD_OK = (result.result == 'SUCCESS').toString()
                            echo "Azure candidate build: ${result.result}"
                        }
                    }
                    if (!buildBranches.isEmpty()) {
                        parallel buildBranches
                    }
                }
            }
        }
        stage('Test Deploy') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    def awsWorkshopName = "caws${env.BUILD_NUMBER}"
                    def azureWorkshopName = "cazs${env.BUILD_NUMBER}"

                    // Define common parameters for AWS deploy
                    def awsDeployParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        booleanParam(name: 'DELETE_DATAHUBS', value: params.DELETE_DATAHUBS),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'DOMAIN', value: "${params.DOMAIN}"),
                        string(name: 'HOSTEDZONEID', value: "${params.HOSTEDZONEID}"),
                        string(name: 'AWS_REGION', value: "${params.AWS_REGION}"),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: awsWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: awsWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CDW,CAI,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDW_TRINO_INSTANCE_TYPE', value: 'AUTO'),
                        string(name: 'CDW_AUTOSUSPEND', value: 'true'),
                        string(name: 'CDW_AUTOSUSPEND_TIMEOUT_SECONDS', value: '300'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'g4dn.xlarge'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'DATALAKE_VERSION', value: "${params.DATALAKE_VERSION}"),
                        string(name: 'ACTION', value: 'provision'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: env.CANDIDATE_TAG),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: false),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AWS_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    // Define common parameters for Azure deploy
                    def azureDeployParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        booleanParam(name: 'DELETE_DATAHUBS', value: params.DELETE_DATAHUBS),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'DOMAIN', value: "${params.DOMAIN}"),
                        string(name: 'HOSTEDZONEID', value: "${params.HOSTEDZONEID}"),
                        string(name: 'AZURE_REGION', value: "${params.AZURE_REGION}"),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: azureWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: azureWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CDW,CAI,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDW_TRINO_INSTANCE_TYPE', value: 'AUTO'),
                        string(name: 'CDW_AUTOSUSPEND', value: 'true'),
                        string(name: 'CDW_AUTOSUSPEND_TIMEOUT_SECONDS', value: '300'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'Standard_D8s_v5'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'Standard_D8s_v5'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'Standard_NC4as_T4_v3'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'DATALAKE_VERSION', value: "${params.DATALAKE_VERSION}"),
                        string(name: 'ACTION', value: 'provision'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: env.CANDIDATE_TAG),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: false),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    def runAws = params.CLOUD_TARGET in ['BOTH', 'AWS']
                    def runAzure = params.CLOUD_TARGET in ['BOTH', 'AZURE']
                    def deployBranches = [:]
                    if (runAws && env.AWS_BUILD_OK == 'true') {
                        deployBranches['AWS'] = {
                            echo 'Triggering AWS deploy job...'
                            def result = build job: REMOTE_JOB_AWS, parameters: awsDeployParams, propagate: false
                            env.AWS_DEPLOY_OK = (result.result == 'SUCCESS').toString()
                            echo "AWS deploy: ${result.result}"
                        }
                    }
                    if (runAzure && env.AZURE_BUILD_OK == 'true') {
                        deployBranches['Azure'] = {
                            echo 'Triggering Azure deploy job...'
                            def result = build job: REMOTE_JOB_AZURE, parameters: azureDeployParams, propagate: false
                            env.AZURE_DEPLOY_OK = (result.result == 'SUCCESS').toString()
                            echo "Azure deploy: ${result.result}"
                        }
                    }
                    if (!deployBranches.isEmpty()) {
                        parallel deployBranches
                    }
                }
            }
            post {
                success {
                    script {
                        currentBuild.result = 'SUCCESS'
                    }
                }
                failure {
                    script {
                        currentBuild.result = 'FAILURE'
                        // Send failure notification for deploy
                        emailext (
                            to: EMAIL_RECIPIENTS,
                            subject: "❌  Pipeline Status: Deploy Stage Failed",
                            body: """
                            <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #ffdddd; background-color: #f8d7da; color: #721c24;">
                                <h2 style="color: #c82333;">❌ The Deploy Stage Has Failed</h2>
                                <p>Please check the logs for more details.</p>
                                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                                    <tr>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job Name</th>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job URL</th>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;">${JOB_NAME}</td>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;"><a href="${env.BUILD_URL}" style="text-decoration: none; color: #337ab7;">${env.BUILD_URL}</a></td>
                                    </tr>
                                </table>
                            </div>
                            """,
                            mimeType: 'text/html',
                            from: 'psejenkins@cloudera.com'
                        )
                        error('Deployment failed, aborting pipeline.')
                    }
                }
            }
        }

        stage('Test Destroy') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    def awsWorkshopName = "caws${env.BUILD_NUMBER}"
                    def azureWorkshopName = "cazs${env.BUILD_NUMBER}"

                    // Define common parameters for AWS destroy
                    def awsDestroyParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        booleanParam(name: 'DELETE_DATAHUBS', value: params.DELETE_DATAHUBS),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'DOMAIN', value: "${params.DOMAIN}"),
                        string(name: 'HOSTEDZONEID', value: "${params.HOSTEDZONEID}"),
                        string(name: 'AWS_REGION', value: "${params.AWS_REGION}"),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: awsWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: awsWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CAI,CDW,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDW_TRINO_INSTANCE_TYPE', value: 'AUTO'),
                        string(name: 'CDW_AUTOSUSPEND', value: 'true'),
                        string(name: 'CDW_AUTOSUSPEND_TIMEOUT_SECONDS', value: '300'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'm5.2xlarge'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'g4dn.xlarge'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'DATALAKE_VERSION', value: "${params.DATALAKE_VERSION}"),
                        string(name: 'ACTION', value: 'destroy'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: env.CANDIDATE_TAG),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: false),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AWS_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    // Define common parameters for Azure destroy
                    def azureDestroyParams = [
                        string(name: 'PROVISION_KEYCLOAK', value: 'YES'),
                        string(name: 'PROVISION_CAII', value: 'NO'),
                        booleanParam(name: 'DELETE_DATAHUBS', value: params.DELETE_DATAHUBS),
                        string(name: 'KEYCLOAK_ADMIN_PASSWORD', value: 'admin'),
                        string(name: 'DOMAIN', value: "${params.DOMAIN}"),
                        string(name: 'HOSTEDZONEID', value: "${params.HOSTEDZONEID}"),
                        string(name: 'AZURE_REGION', value: "${params.AZURE_REGION}"),
                        string(name: 'CDP_DEPLOYMENT_TYPE', value: 'public'),
                        string(name: 'LOCAL_MACHINE_IP', value: '0.0.0.0/0'),
                        string(name: 'WORKSHOP_NAME', value: azureWorkshopName),
                        string(name: 'NUMBER_OF_WORKSHOP_USERS', value: '1'),
                        string(name: 'WORKSHOP_USER_PREFIX', value: azureWorkshopName),
                        password(name: 'WORKSHOP_USER_DEFAULT_PASSWORD', value: 'changeme'),
                        string(name: 'ENABLE_DATA_SERVICES', value: 'CDE,CAI,CDW,CDF'),
                        string(name: 'CDW_VRTL_WAREHOUSE_SIZE', value: 'xsmall'),
                        string(name: 'CDW_DATAVIZ_SIZE', value: 'viz-default'),
                        string(name: 'CDW_TRINO_INSTANCE_TYPE', value: 'AUTO'),
                        string(name: 'CDW_AUTOSUSPEND', value: 'true'),
                        string(name: 'CDW_AUTOSUSPEND_TIMEOUT_SECONDS', value: '300'),
                        string(name: 'CDE_SPARK_VERSION', value: 'AUTO'),
                        string(name: 'CDE_VC_TIER', value: 'CORE'),
                        string(name: 'CDE_INSTANCE_TYPE', value: 'Standard_D8s_v5'),
                        string(name: 'CDE_INITIAL_INSTANCES', value: '1'),
                        string(name: 'CDE_MIN_INSTANCES', value: '0'),
                        string(name: 'CDE_MAX_INSTANCES', value: '25'),
                        string(name: 'CAI_WS_INSTANCE_TYPE', value: 'Standard_D8s_v5'),
                        string(name: 'CAI_MIN_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_INSTANCES', value: '1'),
                        booleanParam(name: 'CAI_ENABLE_GPU', value: false),
                        string(name: 'CAI_GPU_INSTANCE_TYPE', value: 'Standard_NC4as_T4_v3'),
                        string(name: 'CAI_MIN_GPU_INSTANCES', value: '1'),
                        string(name: 'CAI_MAX_GPU_INSTANCES', value: '1'),
                        string(name: 'CDF_INSTANCE_TYPE', value: ''),
                        string(name: 'CDF_MIN_NODES', value: '3'),
                        string(name: 'CDF_MAX_NODES', value: '3'),
                        booleanParam(name: 'CDF_USE_PUBLIC_LB', value: true),
                        string(name: 'DATALAKE_VERSION', value: "${params.DATALAKE_VERSION}"),
                        string(name: 'ACTION', value: 'destroy'),  // Set action for deploy
                        string(name: 'IMAGE_TAG', value: env.CANDIDATE_TAG),
                        booleanParam(name: 'BUILD_LOCAL_IMAGE', value: false),
                        string(name: 'IMAGE_BUILD_BRANCH', value: "${params.AZURE_BUILD_BRANCH}"),
                        string(name: 'IMAGE_BUILD_TF_QS_VER', value: 'main')
                    ]

                    def runAws = params.CLOUD_TARGET in ['BOTH', 'AWS']
                    def runAzure = params.CLOUD_TARGET in ['BOTH', 'AZURE']
                    def destroyBranches = [:]
                    if (runAws && env.AWS_DEPLOY_OK == 'true') {
                        destroyBranches['AWS'] = {
                            echo 'Triggering AWS destroy job...'
                            def result = build job: REMOTE_JOB_AWS, parameters: awsDestroyParams, propagate: false
                            env.AWS_DESTROY_OK = (result.result == 'SUCCESS').toString()
                            echo "AWS destroy: ${result.result}"
                        }
                    }
                    if (runAzure && env.AZURE_DEPLOY_OK == 'true') {
                        destroyBranches['Azure'] = {
                            echo 'Triggering Azure destroy job...'
                            def result = build job: REMOTE_JOB_AZURE, parameters: azureDestroyParams, propagate: false
                            env.AZURE_DESTROY_OK = (result.result == 'SUCCESS').toString()
                            echo "Azure destroy: ${result.result}"
                        }
                    }
                    if (!destroyBranches.isEmpty()) {
                        parallel destroyBranches
                    }
                }
            }
            post {
                success {
                    script {
                        currentBuild.result = 'SUCCESS'
                    }
                }
                failure {
                    script {
                        currentBuild.result = 'FAILURE'
                        // Send email notification when deploy succeeded but destroy failed
                        emailext (
                            to: EMAIL_RECIPIENTS,
                            subject: "❌ Pipeline Status: Deploy Success, Destroy Failed",
                            body: """
                            <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #ffdddd; background-color: #f8d7da; color: #721c24;">
                                <h2 style="color: #c82333;">❌ Pipeline Status Update</h2>
                                <p style="color: #c82333;">Deploy Stage: <strong>SUCCESS</strong></p>
                                <p style="color: #c82333;">Destroy Stage: <strong>FAILED</strong></p>
                                <p>Please check the logs for more details.</p>
                                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                                    <tr>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job Name</th>
                                        <th style="background-color: #f2dede; padding: 10px; border: 1px solid #e0e0e0; text-align: left;">Job URL</th>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;">${JOB_NAME}</td>
                                        <td style="padding: 10px; border: 1px solid #e0e0e0;"><a href="${env.BUILD_URL}" style="text-decoration: none; color: #337ab7;">${env.BUILD_URL}</a></td>
                                    </tr>
                                </table>
                            </div>
                            """,
                            mimeType: 'text/html',
                            from: 'psejenkins@cloudera.com'
                        )
                    }
                }
            }
        }

        stage('Promote Verified Images') {
            steps {
                script {
                    def promotionBranches = [:]
                    if (env.AWS_DESTROY_OK == 'true') {
                        promotionBranches['AWS'] = {
                            def result = build job: BUILD_JOB_AWS, parameters: [
                                string(name: 'PRIMARY_TAG', value: 'latest'),
                                string(name: 'PROMOTE_SOURCE_TAG', value: env.CANDIDATE_TAG),
                                booleanParam(name: 'PUSH_SECONDARY_TAG', value: false),
                                booleanParam(name: 'REFRESH_JENKINSFILE', value: false)
                            ], propagate: false
                            env.AWS_PROMOTE_OK = (result.result == 'SUCCESS').toString()
                            echo "AWS promotion: ${result.result}"
                        }
                    }
                    if (env.AZURE_DESTROY_OK == 'true') {
                        promotionBranches['Azure'] = {
                            def result = build job: BUILD_JOB_AZURE, parameters: [
                                string(name: 'PRIMARY_TAG', value: 'latest'),
                                string(name: 'PROMOTE_SOURCE_TAG', value: env.CANDIDATE_TAG),
                                booleanParam(name: 'PUSH_SECONDARY_TAG', value: false),
                                booleanParam(name: 'REFRESH_JENKINSFILE', value: false)
                            ], propagate: false
                            env.AZURE_PROMOTE_OK = (result.result == 'SUCCESS').toString()
                            echo "Azure promotion: ${result.result}"
                        }
                    }
                    if (!promotionBranches.isEmpty()) {
                        parallel promotionBranches
                    }
                    def failedClouds = []
                    if (params.CLOUD_TARGET in ['BOTH', 'AWS'] && env.AWS_PROMOTE_OK != 'true') {
                        failedClouds.add('AWS')
                    }
                    if (params.CLOUD_TARGET in ['BOTH', 'AZURE'] && env.AZURE_PROMOTE_OK != 'true') {
                        failedClouds.add('Azure')
                    }
                    if (failedClouds) {
                        error("Candidate build, deploy, destroy, or promotion failed for: ${failedClouds.join(', ')}")
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def statusText = { value ->
                    value == 'true' ? 'SUCCESS' : value == 'false' ? 'FAILED' : 'NOT RUN'
                }
                def cloudRow = { String cloud, boolean selected ->
                    if (!selected) {
                        return ''
                    }
                    """
                    <tr>
                        <td>${cloud}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_BUILD_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_DEPLOY_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_DESTROY_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_PROMOTE_OK"])}</td>
                    </tr>
                    """
                }
                def results = cloudRow('AWS', params.CLOUD_TARGET in ['BOTH', 'AWS']) +
                    cloudRow('Azure', params.CLOUD_TARGET in ['BOTH', 'AZURE'])
                emailext (
                    to: EMAIL_RECIPIENTS,
                    subject: "✅ PollSCM: ${params.CLOUD_TARGET} images promoted to latest",
                    body: """
                    <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #d4edda; background-color: #d4edda; color: #155724;">
                        <h2>✅ Verified image promotion succeeded</h2>
                        <p>The selected cloud images passed candidate build, provision and destroy, then were promoted to <strong>latest</strong>.</p>
                        <p>Candidate tag: ${env.CANDIDATE_TAG ?: 'N/A'}</p>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <tr><th>Cloud</th><th>Candidate build</th><th>Provision</th><th>Destroy</th><th>Promotion</th></tr>
                            ${results}
                        </table>
                        <p>Job: ${JOB_NAME} — <a href="${env.BUILD_URL}">View build details</a></p>
                    </div>
                    """,
                    mimeType: 'text/html',
                    from: 'psejenkins@cloudera.com'
                )
            }
        }
        failure {
            script {
                def statusText = { value ->
                    value == 'true' ? 'SUCCESS' : value == 'false' ? 'FAILED' : 'NOT RUN'
                }
                def cloudRow = { String cloud, boolean selected ->
                    if (!selected) {
                        return ''
                    }
                    """
                    <tr>
                        <td>${cloud}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_BUILD_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_DEPLOY_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_DESTROY_OK"])}</td>
                        <td>${statusText(env["${cloud.toUpperCase()}_PROMOTE_OK"])}</td>
                    </tr>
                    """
                }
                def results = cloudRow('AWS', params.CLOUD_TARGET in ['BOTH', 'AWS']) +
                    cloudRow('Azure', params.CLOUD_TARGET in ['BOTH', 'AZURE'])
                emailext (
                    to: EMAIL_RECIPIENTS,
                    subject: "❌ PollSCM: ${params.CLOUD_TARGET} image verification or promotion failed",
                    body: """
                    <div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #f8d7da; background-color: #f8d7da; color: #721c24;">
                        <h2>❌ Candidate verification or image promotion failed</h2>
                        <p>A failed or unrun step prevents that cloud's candidate from being promoted. A successful cloud may still have been promoted independently.</p>
                        <p>Candidate tag: ${env.CANDIDATE_TAG ?: 'N/A'}</p>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <tr><th>Cloud</th><th>Candidate build</th><th>Provision</th><th>Destroy</th><th>Promotion</th></tr>
                            ${results}
                        </table>
                        <p>Job: ${JOB_NAME} — <a href="${env.BUILD_URL}">View build details</a></p>
                    </div>
                    """,
                    mimeType: 'text/html',
                    from: 'psejenkins@cloudera.com'
                )
            }
        }
        always {
            script {
                echo "Pipeline completed with status: ${currentBuild.result}"
            }
        }
    }
}
